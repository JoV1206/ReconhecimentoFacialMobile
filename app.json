{
  "expo": {
    "name": "Reconhecimento Facial",
    "slug": "APP_Cam_RECONHECIMENTOFACIAL",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1120"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reconhecimentofacial.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O app precisa da camera para detectar e reconhecer rostos em tempo real."
      }
    },
    "android": {
      "package": "com.reconhecimentofacial.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1120"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "O app precisa da camera para detectar e reconhecer rostos em tempo real.",
          "enableMicrophonePermission": false,
          "enableCodeScanner": false
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para cadastrar o rosto de uma pessoa.",
          "cameraPermission": "O app precisa da camera para fotografar o rosto de uma pessoa."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "55dce90c-9e3f-40c1-88cf-18f0ef9e6c24"
      }
    },
    "owner": "joao4041",
    "updates": {
      "url": "https://u.expo.dev/55dce90c-9e3f-40c1-88cf-18f0ef9e6c24"
    }
  }
}
